rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isOwner(ownerId) { return isSignedIn() && request.auth.uid == ownerId; }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      return data.keys().hasAll(['phone', 'role']) &&
             data.keys().size() >= 2 &&
             data.phone is string && data.phone.size() <= 15 &&
             data.role in ['admin', 'customer'] &&
             (data.get('address', '') is string) &&
             (data.get('name', '') is string);
    }

    function isValidStore(data) {
      return data.keys().hasAll(['name', 'ownerId']) &&
             data.name is string && data.name.size() <= 100 &&
             data.ownerId == request.auth.uid;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'storeId', 'ownerId']) &&
             data.name is string && data.name.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.storeId is string &&
             data.ownerId == request.auth.uid;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['customerId', 'storeId', 'items', 'total', 'ownerId']) &&
             data.customerId == request.auth.uid &&
             data.ownerId == get(/databases/$(database)/documents/stores/$(data.storeId)).data.ownerId &&
             data.items is list && data.items.size() > 0 &&
             data.total is number && data.total >= 0;
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId);
      allow list: if false; // Users shouldn't be listable by anyone
      allow create: if isSignedIn() && (request.auth.uid == userId) && isValidUser(incoming());
      allow update: if isSignedIn() && (request.auth.uid == userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'address']);
    }

    match /stores/{storeId} {
      allow read: if true; // Public access for customers to browse
      allow create: if isSignedIn() && isValidStore(incoming());
      allow update: if isSignedIn() && isOwner(existing().ownerId) && isValidStore(incoming());
      allow delete: if isSignedIn() && isOwner(existing().ownerId);
    }

    match /products/{productId} {
      allow read: if true; // Public access for browsing
      allow create: if isSignedIn() && isValidProduct(incoming());
      allow update: if isSignedIn() && isOwner(existing().ownerId) && isValidProduct(incoming());
      allow delete: if isSignedIn() && isOwner(existing().ownerId);
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && (request.auth.uid == resource.data.customerId || isOwner(resource.data.ownerId));
      allow list: if isSignedIn(); // Filtering happens via query
      allow create: if isSignedIn() && isValidOrder(incoming());
      allow update: if isSignedIn() && (
        // Customer can cancel if still pending
        (request.auth.uid == existing().customerId && existing().status == 'pending' && incoming().status == 'cancelled' && incoming().diff(existing()).affectedKeys().hasOnly(['status'])) ||
        // Store owner can accept/complete/update payment
        (isOwner(existing().ownerId) && incoming().diff(existing()).affectedKeys().hasAny(['status', 'paymentStatus']))
      ) && (incoming().diff(existing()).affectedKeys().size() > 0);
    }
  }
}
